// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  clerkUserId      String   @unique
  email            String
  firstName        String?
  lastName         String?
  subscriptionTier String   @default("free") // free | investor | pro
  stripeCustomerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  properties   Property[]
  subscription Subscription?
}

model Property {
  id                     String   @id @default(cuid())
  userId                 String
  nickname               String?
  addressLine1           String
  addressLine2           String?
  city                   String
  state                  String
  zipCode                String
  propertyType           String   @default("single_family") // single_family | multi_family
  units                  Int      @default(1)
  purchasePrice          Decimal  @db.Decimal(14, 2)
  purchaseDate           DateTime @db.Date
  currentEstimatedValue  Decimal  @db.Decimal(14, 2)
  currentMonthlyRent     Decimal  @db.Decimal(12, 2)
  currentMonthlyExpenses Decimal  @db.Decimal(12, 2)
  cashInvested           Decimal? @db.Decimal(14, 2)
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mortgages Mortgage[]
}

model Mortgage {
  id                 String   @id @default(cuid())
  propertyId         String
  originalLoanAmount Decimal  @db.Decimal(14, 2)
  currentBalance     Decimal  @db.Decimal(14, 2)
  interestRate       Decimal  @db.Decimal(6, 4)
  termYears          Int
  startDate          DateTime @db.Date
  monthlyPayment     Decimal  @db.Decimal(12, 2)
  escrowIncluded     Boolean  @default(false)
  lenderName         String?
  loanType           String? // e.g. conventional, fha
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeSubscriptionId String?
  status               String // active | canceled | past_due | etc.
  planName             String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
