# Database (required for Prisma)
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth (Clerk — required for sign-in/sign-up)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
# CLERK_SECRET_KEY=sk_...
# Optional: Clerk Frontend API origin for preconnect (e.g. https://your-instance.clerk.accounts.dev)
# NEXT_PUBLIC_CLERK_PRECONNECT_ORIGIN=https://clerk.veldportfolio.com
# Redirect after sign-in/sign-up (defaults to / if unset; OAuth uses fallback)
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Stripe (required for billing)
# Create products/prices in Stripe Dashboard for Investor (5 props) and Pro (20 props), then set:
# STRIPE_SECRET_KEY=sk_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (required on Vercel: webhook signature verification; deploy fails if unset)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
# STRIPE_PRICE_ID_INVESTOR_MONTHLY=price_... (recurring price for Investor plan)
# STRIPE_PRICE_ID_PRO_MONTHLY=price_...      (recurring price for Pro plan)
# STRIPE_PRICE_ID_INVESTOR_YEARLY=price_... (recurring price for Investor plan)
# STRIPE_PRICE_ID_PRO_YEARLY=price_...      (recurring price for Pro plan)

# Display prices (optional; defaults: Investor $15/$150, Pro $29/$290)
# NEXT_PUBLIC_PRICE_INVESTOR_MONTHLY=15
# NEXT_PUBLIC_PRICE_INVESTOR_YEARLY=150
# NEXT_PUBLIC_PRICE_PRO_MONTHLY=29
# NEXT_PUBLIC_PRICE_PRO_YEARLY=290

# App URL (for redirects, webhooks, sitemap.xml, robots.txt — must be your canonical public origin in Vercel Production)
# Local: http://localhost:3000
# Production: https://veldportfolio.com  (do not use *.vercel.app if that is not your canonical domain)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# CSP: set CSP_ENFORCEMENT=true in production after triaging report-only violations (watch CSP reports at /api/csp-report first)
# CSP_ENFORCEMENT=

# Rent estimate (RentCast — optional; enables "Estimate rent" in property forms)
# Get API key at https://app.rentcast.io/app/api
# RENTCAST_API_KEY=

# Google Places (optional; enables address autocomplete in add-property wizard)
# GOOGLE_PLACES_API_KEY=

# Admin (optional; comma-separated emails allowed to access /admin)
# ADMIN_EMAILS=admin@example.com

# Cron (required for Vercel Cron jobs; set the same value in Vercel Environment Variables)
# Generate with: openssl rand -hex 32
# CRON_SECRET=

# Unsubscribe HMAC (optional; falls back to CRON_SECRET if unset)
# Separate from CRON_SECRET so rotating the cron secret doesn't break outstanding unsubscribe links.
# Generate with: openssl rand -hex 32
# UNSUBSCRIBE_HMAC_SECRET=

# Support (launch pre-flight; for Contact/Support link in footer or Settings)
# Create a support email, then set:
# SUPPORT_EMAIL=support@yourdomain.com

# Contact form (Resend — required for contact form to send emails)
# Get API key at https://resend.com/api-keys. Verify domain at https://resend.com/domains for production.
# RESEND_API_KEY=
# RESEND_FROM_DOMAIN=yourdomain.com (optional; uses onboarding@resend.dev when unset)

# Sentry (optional; enables error tracking in production)
# Get DSN from https://sentry.io → Project Settings → Client Keys
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_AUTH_TOKEN=xxx
# SENTRY_ORG=xxx
# SENTRY_PROJECT=xxx

# PostHog (optional; product analytics — funnels, pageviews when key is set)
# Create a project at https://posthog.com — use Project API key below.
# US cloud default host: https://us.i.posthog.com — EU projects use https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Ads (optional; loads gtag.js for conversion measurement in Google Ads when set)
# From Google Ads → Tools → Data manager → Google tag. Format: AW-...
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-...
# Optional conversion labels from Google Ads for event-level optimization:
# NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_CONVERSION_LABEL=AW-.../...
# NEXT_PUBLIC_GOOGLE_ADS_PROPERTY_CREATED_CONVERSION_LABEL=AW-.../...
# NEXT_PUBLIC_GOOGLE_ADS_CTA_CLICKED_CONVERSION_LABEL=AW-.../...
