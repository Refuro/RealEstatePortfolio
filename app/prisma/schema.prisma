// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  clerkUserId           String    @unique
  email                 String
  firstName             String?
  lastName              String?
  subscriptionTier       String    @default("free") // free | investor | pro
  subscriptionTierOverride String? // When set, overrides Stripe; null = use subscriptionTier
  stripeCustomerId      String?
  ownershipDisplayMode  String?   // proportional (default) | full_liability
  onboardingWelcomeSeenAt DateTime?
  onboardingDismissedAt   DateTime?
  onboardingModeledAt     DateTime?
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  properties       Property[]
  savedDeals       SavedDeal[]
  rentCastApiCalls RentCastApiCall[]
  subscription     Subscription?
}

model SavedDeal {
  id                     String    @id @default(cuid())
  userId                 String
  nickname               String?
  addressLine1           String
  addressLine2           String?
  city                   String
  state                  String
  zipCode                String
  purchasePrice          Decimal?  @db.Decimal(14, 2)
  currentEstimatedValue  Decimal?  @db.Decimal(14, 2)
  currentMonthlyRent     Decimal   @db.Decimal(12, 2)
  currentMonthlyExpenses Decimal   @db.Decimal(12, 2)
  totalMortgageBalance   Decimal   @default(0) @db.Decimal(14, 2)
  totalMonthlyPayment    Decimal   @default(0) @db.Decimal(12, 2)
  ownershipPercent       Int       @default(100)
  vacancyPercent         Int       @default(5)
  cashInvested           Decimal?  @db.Decimal(14, 2)
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Property {
  id                     String   @id @default(cuid())
  userId                 String
  nickname               String?
  addressLine1           String
  addressLine2           String?
  city                   String
  state                  String
  zipCode                String
  propertyType           String   @default("single_family") // single_family | condo | townhouse | manufactured | multi_family | apartment
  units                  Int      @default(1)
  ownershipPercent       Int      @default(100) // 1-100, for partial ownership
  purchasePrice          Decimal  @db.Decimal(14, 2)
  purchaseDate           DateTime @db.Date
  currentEstimatedValue  Decimal  @db.Decimal(14, 2)
  currentMonthlyRent     Decimal  @db.Decimal(12, 2)
  isRented               Boolean  @default(true)
  unitRents              Json?    // array of numbers, one per unit. Single-family: [total]. Multi-family: [1500, 1900]. Total = sum.
  bedrooms               Int?
  bathrooms              Decimal? @db.Decimal(4, 2)
  unitMix                String?  // e.g. "2BR, 3BR" for multi-family
  squareFeet             Int?     // optional; improves RentCast AVM when set
  currentMonthlyExpenses Decimal  @db.Decimal(12, 2)
  vacancyPercent         Int      @default(5) // 0-100, expected vacancy; reduces rent in cash flow
  cashInvested           Decimal? @db.Decimal(14, 2)
  notes                  String?
  marketRent             Decimal? @db.Decimal(12, 2)
  marketRentAsOf         DateTime? @db.Date
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mortgages Mortgage[]
}

model Mortgage {
  id                    String    @id @default(cuid())
  propertyId             String
  originalLoanAmount     Decimal   @db.Decimal(14, 2)
  currentBalance        Decimal   @db.Decimal(14, 2)
  balanceAsOfDate       DateTime? @db.Date
  interestRate          Decimal   @db.Decimal(6, 4)
  termYears             Int
  startDate              DateTime  @db.Date
  monthlyPayment        Decimal   @db.Decimal(12, 2)
  paymentEffectiveDate   DateTime? @db.Date
  escrowIncluded        Boolean   @default(false)
  escrowAmount          Decimal?  @db.Decimal(12, 2)
  lenderName            String?
  loanType              String? // e.g. conventional, fha
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

/// One row per successful RentCast API response. Hourly quota is a shared pool (rent + value + benchmark); see docs/reference/rentcast-quota.md.
model RentCastApiCall {
  id         String   @id @default(cuid())
  userId     String
  propertyId String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ContactFormSubmission {
  id         String   @id @default(cuid())
  identifier String   // userId when signed in, or "ip:xxx" for guests
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

// Generic rate limit for API write endpoints (properties, deals, import, account/delete, billing)
model ApiRateLimitEntry {
  id         String   @id @default(cuid())
  identifier String   // user:userId or ip:xxx
  action     String   // e.g. "properties:create", "deals:create"
  createdAt  DateTime @default(now())

  @@index([identifier, action, createdAt])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeSubscriptionId String?
  status               String // active | canceled | past_due | etc.
  planName             String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean?  // true when user canceled; access until currentPeriodEnd
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
