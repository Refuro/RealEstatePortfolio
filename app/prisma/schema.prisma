// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String    @id @default(cuid())
  clerkUserId           String    @unique
  email                 String
  firstName             String?
  lastName              String?
  subscriptionTier       String    @default("free") // free | investor | pro
  subscriptionTierOverride String? // When set, overrides Stripe; null = use subscriptionTier
  trialStartedAt        DateTime?
  trialEndsAt           DateTime?
  trialEmailsSentAt     Json?     // { day10: ISOString | null, day13: ISOString | null, expired: ISOString | null }
  stripeCustomerId      String?
  onboardingWelcomeSeenAt DateTime?
  onboardingDismissedAt   DateTime?
  onboardingModeledAt     DateTime?
  onboardingEmailsSentAt      Json?     // { day3: ISOString | null, day7: ISOString | null }
  onboardingEmailsOptedOutAt  DateTime? // null = subscribed, date = unsubscribed
  lastActiveAt                DateTime?
  digestEmailsSentAt          Json?     // { "2026-05": ISOString, ... }
  digestEmailsOptedOutAt      DateTime? // null = subscribed, date = unsubscribed from digest/milestones
  mortgageMilestonesSentAt    Json?     // milestone sentinel map: { "<propertyId>__ltv_50": ISOString, "<propertyId>__<mortgageId>__payoff_5yr": ISOString }
  winbackEmailsSentAt         Json?     // { "6mo": ISOString, "12mo": ISOString, "__unsubscribedAt": ISOString }
  deletedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  properties       Property[]
  savedDeals       SavedDeal[]
  rentCastApiCalls RentCastApiCall[]
  subscription     Subscription?
}

model SavedDeal {
  id                     String    @id @default(cuid())
  userId                 String
  nickname               String?
  addressLine1           String
  addressLine2           String?
  city                   String
  state                  String
  zipCode                String
  purchasePrice          Decimal?  @db.Decimal(14, 2)
  currentEstimatedValue  Decimal?  @db.Decimal(14, 2)
  currentMonthlyRent     Decimal   @db.Decimal(12, 2)
  currentMonthlyExpenses Decimal   @db.Decimal(12, 2)
  totalMortgageBalance   Decimal   @default(0) @db.Decimal(14, 2)
  totalMonthlyPayment    Decimal   @default(0) @db.Decimal(12, 2)
  ownershipPercent       Int       @default(100)
  vacancyPercent         Int       @default(5)
  cashInvested           Decimal?  @db.Decimal(14, 2)
  notes                  String?
  bedrooms               Int?
  bathrooms              Decimal?  @db.Decimal(4, 2)
  squareFeet             Int?
  propertyType           String?
  marketRent             Decimal?  @db.Decimal(12, 2)
  marketRentAsOf         DateTime? @db.Date
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Property {
  id                     String   @id @default(cuid())
  userId                 String
  nickname               String?
  addressLine1           String
  addressLine2           String?
  city                   String
  state                  String
  zipCode                String
  propertyType           String   @default("single_family") // single_family | condo | townhouse | manufactured | multi_family | apartment
  units                  Int      @default(1)
  ownershipPercent       Int      @default(100) // 1-100, for partial ownership
  purchasePrice          Decimal  @db.Decimal(14, 2)
  purchaseDate           DateTime @db.Date
  currentEstimatedValue  Decimal  @db.Decimal(14, 2)
  currentMonthlyRent     Decimal  @db.Decimal(12, 2)
  isRented               Boolean  @default(true)
  unitRents              Json?    // array of numbers, one per unit. Single-family: [total]. Multi-family: [1500, 1900]. Total = sum.
  bedrooms               Int?
  bathrooms              Decimal? @db.Decimal(4, 2)
  squareFeet             Int?
  hasMortgage            Boolean?
  mortgagePaidOff        Boolean  @default(false)
  currentMonthlyExpenses Decimal  @db.Decimal(12, 2)
  vacancyPercent         Int      @default(5) // 0-100, expected vacancy; reduces rent in cash flow
  cashInvested           Decimal? @db.Decimal(14, 2)
  notes                  String?
  marketRent             Decimal? @db.Decimal(12, 2)
  marketRentAsOf         DateTime? @db.Date
  estimatedValueAsOf     DateTime? @db.Date
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mortgages Mortgage[]
  snapshots PropertySnapshot[]

  @@index([userId])
}

model PropertySnapshot {
  id                       String   @id @default(cuid())
  propertyId               String
  snapshotMonth            DateTime @db.Date
  estimatedValue           Decimal  @db.Decimal(14, 2)
  effectiveMortgageBalance Decimal  @db.Decimal(14, 2)
  equity                   Decimal  @db.Decimal(14, 2)
  marketRent               Decimal? @db.Decimal(12, 2)
  monthlyRent              Decimal  @db.Decimal(12, 2)
  monthlyCashFlow          Decimal  @db.Decimal(12, 2)
  capRate                  Decimal? @db.Decimal(8, 6)
  ltv                      Decimal? @db.Decimal(8, 6)
  avmValueRaw              Decimal? @db.Decimal(14, 2)
  avmRentRaw               Decimal? @db.Decimal(12, 2)
  avmValueApplied          Boolean  @default(false)
  avmRentApplied           Boolean  @default(false)
  /// Ownership fraction at snapshot time (ownershipPercent / 100). Null = legacy row; treat as 1.0.
  ownershipPct             Float?
  /// Total monthly mortgage payment at snapshot time. Required to re-derive full-liability cash flow.
  monthlyPayment           Decimal? @db.Decimal(12, 2)
  createdAt                DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, snapshotMonth])
  @@index([propertyId])
}

model Mortgage {
  id                    String    @id @default(cuid())
  propertyId             String
  originalLoanAmount     Decimal   @db.Decimal(14, 2)
  currentBalance        Decimal   @db.Decimal(14, 2)
  balanceAsOfDate       DateTime? @db.Date
  interestRate          Decimal   @db.Decimal(6, 4)
  termYears             Int
  startDate              DateTime  @db.Date
  monthlyPayment        Decimal   @db.Decimal(12, 2)
  paymentEffectiveDate   DateTime? @db.Date
  escrowIncluded        Boolean   @default(false)
  escrowAmount          Decimal?  @db.Decimal(12, 2)
  lenderName            String?
  loanType              String? // e.g. conventional, fha
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

/// One row per successful RentCast API response. Hourly quota is a shared pool (rent + value + benchmark); see docs/reference/rentcast-quota.md.
model RentCastApiCall {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String?
  propertyId String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model ContactFormSubmission {
  id         String   @id @default(cuid())
  identifier String   // userId when signed in, or "ip:xxx" for guests
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

// Generic rate limit for API write endpoints (properties, deals, import, account/delete, billing)
model ApiRateLimitEntry {
  id         String   @id @default(cuid())
  identifier String   // user:userId or ip:xxx
  action     String   // e.g. "properties:create", "deals:create"
  createdAt  DateTime @default(now())

  @@index([identifier, action, createdAt])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeSubscriptionId String?
  status               String // active | canceled | past_due | etc.
  planName             String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean?  // true when user canceled; access until currentPeriodEnd
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One row per Stripe webhook `event.id` after a successful PostHog server capture — prevents duplicate analytics on Stripe retries.
model StripePosthogDedup {
  eventId   String   @id
  createdAt DateTime @default(now())
}
